@echo off
REM ============================================================
REM  本地私有环境变量模板
REM
REM  用法：
REM    1. 复制本文件为 env.local.bat（同目录）
REM    2. 按需修改下面的值
REM    3. start-backend.bat 启动时会自动加载 env.local.bat
REM
REM  env.local.bat 已被 .gitignore 排除，不会提交到仓库。
REM ============================================================

REM 数据库密码（必填）
set "DB_PASSWORD=your-mysql-password"

REM 数据库用户名，默认 root
set "DB_USERNAME=root"

REM 支付宝异步通知地址（公网可达）。
REM 本地调试可用内网穿透，例如 natapp / cpolar 分配的域名；
REM 不设置时后端回落到 http://localhost:8080/pay/notify/alipay，
REM 只能在本机访问，支付宝的异步回调到不了。
REM set "PAY_NOTIFY_URL=https://your-tunnel-domain/pay/notify/alipay"
